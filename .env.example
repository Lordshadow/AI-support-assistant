# =============================================================================
# NovaRetail Customer Support Assistant - Environment Configuration Template
# Copy this file to .env and fill in your API keys
# =============================================================================

# 1. AI & LLM Model APIs
# Enter your Groq API Key (get free instant API key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_SMALL_MODEL=openai/gpt-oss-20b
GROQ_LARGE_MODEL=openai/gpt-oss-120b

# Optional: NVIDIA NIM API Key for dense neural embeddings
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
APP_ENV=development
CATALOG_EMBEDDING_MODEL=baai/bge-m3
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_ATTEMPTS=3
APEXSTORE_CATALOG_TIMEOUT_SECONDS=30
APEXSTORE_CATALOG_MAX_ATTEMPTS=4
APEXSTORE_CATALOG_REQUESTS_PER_SECOND=2

# Provider-neutral catalog knowledge sync (preferred for new stores).
# The API must be read-only, paginated, and return the contract documented in
# support-assistant/docs/catalog-api-integration.md. Keep the token server-side.
CATALOG_API_URL=https://store.example.com/api
CATALOG_API_TOKEN=replace_with_read_only_catalog_token
CATALOG_API_AUTH_MODE=bearer
CATALOG_API_TOKEN_HEADER=X-API-Key
CATALOG_API_PATH=catalog/export
CATALOG_API_PRODUCTS_PATH=products
CATALOG_API_PAGE_PARAM=page
CATALOG_API_PAGE_SIZE_PARAM=limit
CATALOG_API_PAGE_SIZE=100
CATALOG_API_TOTAL_PATH=pagination.total
CATALOG_API_TOTAL_PAGES_PATH=pagination.total_pages
CATALOG_API_TOTAL_HEADER=
CATALOG_API_TOTAL_PAGES_HEADER=
CATALOG_API_TIMEOUT_SECONDS=30
CATALOG_API_MAX_ATTEMPTS=4
CATALOG_API_REQUESTS_PER_SECOND=2

# Legacy ApexStore source settings remain as a fallback for catalog sync.
# These are also used by existing order/refund integrations: keep them intact
# when updating the separate catalog credentials above.
APEXSTORE_CATALOG_API_URL=http://host.docker.internal:5000/api/assistant/v1
APEXSTORE_CATALOG_API_TOKEN=replace_with_customer_orders_read_token
APEXSTORE_REFUND_SYNC_URL=http://host.docker.internal:5000/api/integrations/refunds/review
APEXSTORE_REFUND_SYNC_SECRET=use_the_same_random_value_as_REFUND_SYNC_SECRET_in_the_store

# Customer step-up OTP delivery. The storefront API token needs orders:read.
OTP_DELIVERY_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# 2. WhatsApp Cloud API Integration (Meta for Developers)
WHATSAPP_APP_SECRET=test_whatsapp_secret_9941
WHATSAPP_VERIFY_TOKEN=novaretail_verify_token_secure
WHATSAPP_PHONE_NUMBER_ID=
OPENWA_SHARED_SECRET=replace_with_random_secret_at_least_32_characters
OPENWA_WEBHOOK_SECRET=replace_with_random_secret_at_least_16_characters
OPENWA_API_URL=http://127.0.0.1:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_PORT=2786
ASSISTANT_OPENWA_URL=http://127.0.0.1:8000/integrations/openwa/messages

# 3. Storefront JWT Authentication
STOREFRONT_JWT_SECRET=novaretail_storefront_customer_jwt_secret_8829

# 4. Database & Cache Infrastructure (required by the production adapters)
NOVARETAIL_TENANT_ID=tenant_novaretail
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=novaretail_db
POSTGRES_USER=novaretail_admin
POSTGRES_PASSWORD=novaretail_secure_pass

REDIS_HOST=localhost
REDIS_PORT=6379

# 5. Local Server Binding
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
