# =============================================================================
# NovaRetail Customer Support Assistant - Environment Configuration Template
# Copy this file to .env and fill in your API keys
# =============================================================================

# 1. AI & LLM Model APIs
# Enter your Groq API Key (get free instant API key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: NVIDIA NIM API Key for dense neural embeddings
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# 2. WhatsApp Cloud API Integration (Meta for Developers)
WHATSAPP_APP_SECRET=test_whatsapp_secret_9941
WHATSAPP_VERIFY_TOKEN=novaretail_verify_token_secure
WHATSAPP_PHONE_NUMBER_ID=

# 3. Storefront JWT Authentication
STOREFRONT_JWT_SECRET=novaretail_storefront_customer_jwt_secret_8829

# 4. Database & Cache Infrastructure (Optional - defaults to in-memory mock adapters if offline)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=novaretail_db
POSTGRES_USER=novaretail_admin
POSTGRES_PASSWORD=novaretail_secure_pass

REDIS_HOST=localhost
REDIS_PORT=6379

# 5. Local Server Binding
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
